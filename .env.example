# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME  (the role needs CREATEDB to run tests)
DATABASE_URL=postgres://vendor_ops:change-me@localhost:5432/vendor_ops

# Browser origins allowed to call the API with cookies (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Business hours used for task due dates (0=Monday ... 6=Sunday).
BUSINESS_TIMEZONE=America/New_York
BUSINESS_DAYS=0,1,2,3,4
BUSINESS_OPEN=09:00
BUSINESS_CLOSE=17:00
DISCOVERY_CALL_DUE_BUSINESS_HOURS=2

# Production only: set true behind HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
# Enable only after HTTPS is working. Start with 3600, then raise to 31536000.
DJANGO_HSTS_SECONDS=0

# --- Email (see README "Email") ----------------------------------------------
# Django queues every message; `manage.py send_due_emails` (systemd timer, every minute) sends.
# Provider: console (local/CI, never sends for real) | smtp_relay (Google Workspace SMTP relay).
EMAIL_PROVIDER=console
# Ceiling for sending: disabled | redirect | enabled. The admin setting can only be stricter.
# Production starts at redirect with EMAIL_REDIRECT_TO set to a team mailbox.
EMAIL_GLOBAL_MODE=disabled
EMAIL_FROM_NAME=The Good Flea
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_REDIRECT_TO=
EMAIL_TIMEZONE=America/New_York
EMAIL_SEND_WINDOW_START=09:00
EMAIL_SEND_WINDOW_END=18:00

# Google Workspace SMTP relay (only used when EMAIL_PROVIDER=smtp_relay). Leave the username and
# password empty if the relay authenticates the droplet by its allowlisted IP address.
EMAIL_SMTP_HOST=smtp-relay.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
