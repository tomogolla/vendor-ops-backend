# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME  (the role needs CREATEDB to run tests)
DATABASE_URL=postgres://vendor_ops:change-me@localhost:5432/vendor_ops

# Browser origins allowed to call the API with cookies (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Business hours used for task due dates (0=Monday ... 6=Sunday).
BUSINESS_TIMEZONE=America/New_York
BUSINESS_DAYS=0,1,2,3,4
BUSINESS_OPEN=09:00
BUSINESS_CLOSE=17:00
DISCOVERY_CALL_DUE_BUSINESS_HOURS=2

# Production only: set true behind HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
# Enable only after HTTPS is working. Start with 3600, then raise to 31536000.
DJANGO_HSTS_SECONDS=0

# --- Email (see README "Email") ----------------------------------------------
# Django queues every message; `manage.py send_due_emails` (systemd timer, every minute) sends.
# Provider: console (local/CI, never sends for real) | smtp_relay (Google Workspace SMTP relay)
# | resend (Resend API through django-anymail).
EMAIL_PROVIDER=console
# Ceiling for sending: disabled | redirect | enabled. The admin setting can only be stricter.
# Production starts at redirect with EMAIL_REDIRECT_TO set to a team mailbox.
EMAIL_GLOBAL_MODE=disabled
EMAIL_FROM_NAME=The Good Flea
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_REDIRECT_TO=
EMAIL_TIMEZONE=America/New_York
EMAIL_SEND_WINDOW_START=09:00
EMAIL_SEND_WINDOW_END=18:00

# Google Workspace SMTP relay (only used when EMAIL_PROVIDER=smtp_relay). Leave the username and
# password empty if the relay authenticates the droplet by its allowlisted IP address.
EMAIL_SMTP_HOST=smtp-relay.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# Resend (only used when EMAIL_PROVIDER=resend). Keep both values in the server environment only.
# API key: Resend dashboard -> API Keys (sending access). Webhook signing secret: Resend dashboard ->
# Webhooks -> the endpoint https://ops.thegoodflea.com/api/v1/webhooks/anymail/resend/tracking/
# (starts with whsec_). Without the secret the webhook refuses every call.
EMAIL_RESEND_API_KEY=
EMAIL_RESEND_WEBHOOK_SECRET=

# Messages sent per day, counted since midnight in EMAIL_TIMEZONE (0 = no limit). The rest wait.
EMAIL_DAILY_LIMIT=90

# --- Public application form (see README "Public application form") ----------------------------
# Kill switch: false (default) makes every /api/v1/public/ endpoint answer 404.
PUBLIC_APPLICATIONS_ENABLED=false
# Cloudflare Turnstile secret key (Cloudflare dashboard -> Turnstile -> the widget). Required when
# the form is on and DJANGO_DEBUG is false (manage.py check refuses to pass without it). Local
# testing: Cloudflare's test secret 1x0000000000000000000000000000000AA always passes and
# 2x0000000000000000000000000000000AA always fails. Never commit the real key.
TURNSTILE_SECRET_KEY=
# Website-form applications per day (business time zone); more answer 503.
PUBLIC_APPLICATIONS_DAILY_CAP=200
# Recorded with each submission's consent when the page does not send consent_text_version.
PUBLIC_APPLICATION_CONSENT_VERSION=2026-10

# Cache shared by all gunicorn workers (throttle counters). Default: the database table
# django_cache, created by `python manage.py createcachetable` (the deploy script runs it).
# CACHE_URL=dbcache://django_cache
